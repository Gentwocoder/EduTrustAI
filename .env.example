# Public Reown application identifier used for WalletConnect and wallet discovery.
NEXT_PUBLIC_REOWN_PROJECT_ID=dbc555579a692e9a597971d5c1358b24

# Legacy shared override used for both networks when network-specific values are absent.
NEXT_PUBLIC_EDUTRUST_REGISTRY_ADDRESS=0x49F1D0F56b9d7217fea0C4E0abAf64200b86505f

# Optional network-specific registry overrides. Use these after deploying V2.
# NEXT_PUBLIC_EDUTRUST_MAINNET_REGISTRY_ADDRESS=0x...
# NEXT_PUBLIC_EDUTRUST_TESTNET_REGISTRY_ADDRESS=0x...

# Optional server-only JSON array of reviewed institution profiles keyed by issuer wallet.
# Never prefix this variable with NEXT_PUBLIC.
EDUTRUST_INSTITUTION_PROFILES_JSON=[]
